+#ifdef SS_HEAPHUGE
+// This thread's malloc heap may use huge pages. glibc gives every thread but the first a heap of its own: a
+// 64 MB reservation at a multiple of 64 MB (that is how free() finds the heap of a pointer). With the top pad
+// set in main() the whole heap is writable from its first use, so the kernel can back it with 2 MB pages: a
+// thread touches 5 to 20 MB of it, one page fault per 4 KB otherwise, and all of it is still there when the
+// process exits, where the kernel frees it page by page on one CPU.
+static void heap_huge() {
+  void* const p = malloc(64);
+  if (!p) return;
+  const uintptr_t base = (uintptr_t)p & ~(((uintptr_t)64 << 20) - 1);
+  madvise((void*)base, (size_t)64 << 20, MADV_HUGEPAGE);  // (advice only: harmless whatever lies there)
+  free(p);
+}
+#endif
